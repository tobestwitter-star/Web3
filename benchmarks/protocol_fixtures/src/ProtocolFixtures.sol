pragma solidity 0.8.20;
contract StateMachineVault { enum Phase { Locked, Prepared, Settled } Phase public phase; address public preparer; mapping(address=>uint256) public credit; function prepare() external { preparer=msg.sender; phase=Phase.Prepared; } function execute(address beneficiary,uint256 amount) external { require(phase==Phase.Prepared,"not prepared"); credit[beneficiary]+=amount; phase=Phase.Settled; } }
contract ReentrancyBank { mapping(address=>uint256) public balance; function deposit() external payable { balance[msg.sender]+=msg.value; } function withdraw() external { uint256 amount=balance[msg.sender]; require(amount>0,"empty"); (bool ok,)=msg.sender.call{value:amount}(""); require(ok,"send failed"); balance[msg.sender]=0; } }
contract ReentrancyAttacker { ReentrancyBank public immutable bank; uint256 public reentries; constructor(ReentrancyBank b){bank=b;} receive() external payable { if(address(bank).balance>=1 ether && reentries<1){reentries++;bank.withdraw();} } function attack() external { bank.deposit{value:1 ether}(); bank.withdraw(); } }
contract UnreachableCandidate { uint256 public state; function suspicious() external { require(state==type(uint256).max,"unreachable state"); state=0; } }
contract InvariantPreserving { mapping(address=>uint256) public balance; uint256 public total; function mint(address to,uint256 amount) external {balance[to]+=amount;total+=amount;} function transfer(address to,uint256 amount) external {require(balance[msg.sender]>=amount,"insufficient");balance[msg.sender]-=amount;balance[to]+=amount;} }
contract AuthorizationSequence { address public owner; address public pendingOperator; mapping(address=>uint256) public credit; constructor(){owner=msg.sender;} function queueOperator(address op) external {require(msg.sender==owner,"owner");pendingOperator=op;} function execute(uint256 amount) external {require(msg.sender==pendingOperator,"operator");credit[msg.sender]+=amount;pendingOperator=address(0);} }
contract EconomicPool { uint256 public reserve0; uint256 public reserve1; constructor(uint256 a,uint256 b){reserve0=a;reserve1=b;} function swap(uint256 amount0In) external returns(uint256 amount1Out){amount1Out=(amount0In*reserve1)/reserve0;require(amount1Out<reserve1,"too much");reserve1-=amount1Out;} }
